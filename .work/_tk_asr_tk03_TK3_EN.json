 "segments": [
  {
   "s": 0.0,
   "e": 3.1,
   "t": "eight years old, locked in a basement with a trapdoor under the table."
  },
  {
   "s": 3.74,
   "e": 8.04,
   "t": "Emper's mother, Clarnel, saw in her son the hated reflection of her ex-husband."
  },
  {
   "s": 8.82,
   "e": 13.22,
   "t": "From age eight, Ed was banished to sleep in a damp basement beside the coal furnace,"
  },
  {
   "s": 13.64,
   "e": 16.18,
   "t": "under a trapdoor beneath the upstairs dining table."
  },
  {
   "s": 16.98,
   "e": 19.72,
   "t": "To leave, the heavy table had to be lifted above."
  },
  {
   "s": 20.22,
   "e": 23.56,
   "t": "Confinement ended only when his father threatened police intervention."
  },
  {
   "s": 24.4,
   "e": 27.28,
   "t": "Every day she subjected him to venomous verbal abuse,"
  },
  {
   "s": 27.28,
   "e": 30.26,
   "t": "mocking his huge frame and crushing his self-esteem."
  },
  {
   "s": 30.98,
   "e": 32.06,
   "t": "In the boy's psyche,"
  },
  {
   "s": 32.54,
   "e": 35.12,
   "t": "the mother loomed as an omnipotent monument of cruelty,"
  },
  {
   "s": 35.66,
   "e": 38.42,
   "t": "violently hated, yet too terrifying to confront."
  },
  {
   "s": 39.42,
   "e": 42.0,
   "t": "Nable to retaliate directly against her,"
  },
  {
   "s": 42.36,
   "e": 44.82,
   "t": "Kemper's brain activated the projection mechanism,"
  },
  {
   "s": 45.2,
   "e": 46.32,
   "t": "seeking proxy victims."
  },
  {
   "s": 47.3,
   "e": 50.12,
   "t": "Young, graceful female students on the roadside"
  },
  {
   "s": 50.12,
   "e": 51.8,
   "t": "embodied the freedom he craved,"
  },
  {
   "s": 52.06,
   "e": 54.72,
   "t": "yet believed would reject him just as his mother had."
  },
  {
   "s": 54.72,
   "e": 60.06,
   "t": "innocent young women bore the horrifying brunt of the murderous fury intended for his own mother."
  },
  {
   "s": 61.02,
   "e": 64.9,
   "t": "A clinical note, psychiatrists offered varied diagnostic labels over the years."
  },
  {
   "s": 65.38,
   "e": 68.34,
   "t": "This represents an explanatory framework, not a moral trial."
  },
  {
   "s": 69.04,
   "e": 73.6,
   "t": "Episode 3 of Amber Eyes. Watch the full dossier via the link in our bio."
  }
 ]
}