 "segments": [
  {
   "s": 0.0,
   "e": 5.72,
   "t": "ロインで最も恩恒だった看護師 その正体は史上最悪の殺人機だった"
  },
  {
   "s": 6.26,
   "e": 12.76,
   "t": "2003年秋 メリカ合衆国ニュージャー g 州サマービルのサマセット医療センター"
  },
  {
   "s": 12.76,
   "e": 18.72,
   "t": "ソマセってメリキロセンター 本13歳のその男は痩せ方で声は小さく"
  },
  {
   "s": 18.72,
   "e": 24.36,
   "t": "常に穏やかな微笑みをたたえ 批兵した同僚のシフトを率先して引き受けていました"
  },
  {
   "s": 25.02,
   "e": 31.16,
   "t": "しかしその趣味ひとつない白衣の裏には 16年もの長期にわたり暗黒の心理的"
  },
  {
   "s": 31.16,
   "e": 39.7,
   "t": "真言を隠蔽し続けた完璧なハロー効果が存在していたのです アンジャの要題が急変すれば彼は常に真っ先に駆けつけ"
  },
  {
   "s": 39.7,
   "e": 54.34,
   "t": "救命所地が失敗に終わった後も一人静かに病室の片付けを行っていました サマセット病院の私たち看護士全員にとってチャーリーは本当に素晴らしい"
  },
  {
   "s": 54.34,
   "e": 59.28,
   "t": "あららげることなど一度もなく、常に驚くほど優しく患者さんに接していました。"
  },
  {
   "s": 59.9,
   "e": 68.22,
   "t": "人騒が暴かれるまで、私たちが史上最悪の連続殺人犯のすぐ隣で勤務していたとは、接地が凍る思いでした。"
  },
  {
   "s": 68.98,
   "e": 77.66,
   "t": "報道心理学の視点から見ると、チャールスカレンは極めて典型的な被害者の極大化と非人間化を示しています。"
  },
  {
   "s": 78.64,
   "e": 83.48,
   "t": "アンバーアイズ第4話プロフィール リンクから完全版ドキュメンタリー"
  },
  {
   "s": 83.48,
   "e": 84.08,
   "t": "をご覧ください"
  }
 ]
