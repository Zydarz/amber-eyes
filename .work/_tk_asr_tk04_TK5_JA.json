 "segments": [
  {
   "s": 0.0,
   "e": 4.3,
   "t": "最大の生存の教訓 決して不正の前に沈黙してはならない"
  },
  {
   "s": 4.9,
   "e": 7.74,
   "t": "同時に私たちは 強行そのものよりも"
  },
  {
   "s": 7.74,
   "e": 10.88,
   "t": "通列な真実 損害賠償訴訟と"
  },
  {
   "s": 10.88,
   "e": 12.78,
   "t": "宝敵責任への恐怖から"
  },
  {
   "s": 13.28,
   "e": 15.56,
   "t": "ココノツの病院が沈黙を守り続けた"
  },
  {
   "s": 15.56,
   "e": 17.32,
   "t": "組織の共犯構造を暴きます"
  },
  {
   "s": 19.14,
   "e": 22.2,
   "t": "それは集団的変質病と生存のための"
  },
  {
   "s": 22.2,
   "e": 23.76,
   "t": "赤い警告シグナルから"
  },
  {
   "s": 23.76,
   "e": 25.72,
   "t": "社会が目を背けた時に"
  },
  {
   "s": 25.72,
   "e": 27.58,
   "t": "支払わされる代償についての"
  },
  {
   "s": 27.58,
   "e": 28.8,
   "t": "重い教訓です"
  },
  {
   "s": 29.58,
   "e": 35.22,
   "t": "2004年ニュージャージー周知事はこの 危険な沈黙の連鎖を永久に立ち切る"
  },
  {
   "s": 35.22,
   "e": 41.2,
   "t": "ためカレン法に署名しました おじに自動薬剤分配器ピクスヤス"
  },
  {
   "s": 41.2,
   "e": 46.34,
   "t": "の運用プロセスも全米で抜本的に 再設計され取り消し機能の抜け"
  },
  {
   "s": 46.34,
   "e": 51.0,
   "t": "穴は完全に塞がれました この悲劇が残した最大の教訓"
  },
  {
   "s": 51.0,
   "e": 56.32,
   "t": "はただ一つ常に自分自身の直感 を信じ耳を傾けることです"
  },
  {
   "s": 56.9,
   "e": 62.32,
   "t": "つ、看護師エイミー・ログレンの勇気は 恐怖を乗り越えて声を上げた一人の人間が"
  },
  {
   "s": 62.62,
   "e": 65.24,
   "t": "無数の生命を救い得ることを証明しました"
  },
  {
   "s": 66.68,
   "e": 74.04,
   "t": "不正の前の沈黙は決して平穏をもたらさず ただ暗闇が罪なき人々を飲み込む手助けをするだけなのです"
  },
  {
   "s": 74.76,
   "e": 80.18,
   "t": "アンバーアイズ第4話 プロフィールリンクから完全版ドキュメンタリーをご覧ください"
  }
 ]
