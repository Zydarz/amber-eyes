 "segments": [
  {
   "s": 0.0,
   "e": 2.98,
   "t": "drinking with the police, and discussing his own murders."
  },
  {
   "s": 3.72,
   "e": 7.62,
   "t": "Jury Room Bar sat directly across from the Santa Cruz County Courthouse,"
  },
  {
   "s": 8.12,
   "e": 10.34,
   "t": "a familiar haunt for detectives after shift."
  },
  {
   "s": 11.18,
   "e": 12.58,
   "t": "Ed was a fixture in the corner,"
  },
  {
   "s": 13.02,
   "e": 18.62,
   "t": "standing 6'9\", wearing wire-rimmed glasses, remarkably courteous and articulate in law."
  },
  {
   "s": 19.24,
   "e": 23.2,
   "t": "By day, he drove a yellow 1969 Ford Galaxy,"
  },
  {
   "s": 23.66,
   "e": 27.12,
   "t": "bearing a university employee parking decal on the front bumper."
  },
  {
   "s": 27.12,
   "e": 33.56,
   "t": "However, that trusted campus decal, combined with his gentle academic facade, made female"
  },
  {
   "s": 33.56,
   "e": 36.38,
   "t": "hitchhikers believe the vehicle was completely safe."
  },
  {
   "s": 37.04,
   "e": 42.06,
   "t": "There were knights detectives drank draft beer with Ed, venting our frustrations over the"
  },
  {
   "s": 42.06,
   "e": 44.02,
   "t": "elusive co-ed killer investigation."
  },
  {
   "s": 45.28,
   "e": 49.84,
   "t": "Ed would nod, sip his beer, analyze the evidence, and offer sharp theories about"
  },
  {
   "s": 49.84,
   "e": 51.62,
   "t": "the killer's psychological profile."
  },
  {
   "s": 52.44,
   "e": 54.62,
   "t": "Looking back, ice chills our spine."
  },
  {
   "s": 54.62,
   "e": 60.24,
   "t": "The monster the entire city was hunting sat beside us, laughing about the very manhunt."
  },
  {
   "s": 60.76,
   "e": 61.84,
   "t": "Halo Effect."
  },
  {
   "s": 62.4,
   "e": 68.86,
   "t": "Superior intelligence and polite gentility formed an invisible camouflage blinding the entire law enforcement apparatus."
  },
  {
   "s": 69.66,
   "e": 71.5,
   "t": "Episode 3 of Amber Eyes."
  },
  {
   "s": 71.94,
   "e": 74.2,
   "t": "Watch the full dossier via the link in our bio."
  }
 ]
}