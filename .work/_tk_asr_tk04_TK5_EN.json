 "segments": [
  {
   "s": 0.0,
   "e": 3.46,
   "t": "The greatest survival lesson never stays silent in the face of wrong."
  },
  {
   "s": 4.54,
   "e": 8.36,
   "t": "Simultaneously, we expose a reality even more disturbing than his crimes,"
  },
  {
   "s": 8.8,
   "e": 12.32,
   "t": "the systemic complicity and prolonged silence of nine medical centers"
  },
  {
   "s": 12.32,
   "e": 14.46,
   "t": "driven by fear of legal liability."
  },
  {
   "s": 15.52,
   "e": 18.4,
   "t": "It stands as an enduring lesson on institutional blind spots"
  },
  {
   "s": 18.4,
   "e": 21.58,
   "t": "and the catastrophic cost of ignoring survival red flags."
  },
  {
   "s": 22.8,
   "e": 27.5,
   "t": "In 2004, the governor of New Jersey enacted the Landmark Cullen Act"
  },
  {
   "s": 27.5,
   "e": 31.12,
   "t": "to permanently dismantle dangerous institutional silence."
  },
  {
   "s": 32.28,
   "e": 37.24,
   "t": "Simultaneously, PIXIS automated dispensing systems were completely overhauled nationwide,"
  },
  {
   "s": 37.7,
   "e": 41.6,
   "t": "eliminating the cancellation loophole and tightening toxic substance tracking."
  },
  {
   "s": 42.28,
   "e": 46.0,
   "t": "The paramount survival lesson preserved by this tragic history is clear."
  },
  {
   "s": 46.48,
   "e": 48.82,
   "t": "Always listen to and honor your own intuition."
  },
  {
   "s": 49.92,
   "e": 54.24,
   "t": "The Courage of Nurse Amy Loughran proves that a single individual willing to confront fear"
  },
  {
   "s": 54.24,
   "e": 56.54,
   "t": "and speak truth, can save countless lives."
  },
  {
   "s": 57.56,
   "e": 59.74,
   "t": "Silence before wrongdoing never brings peace."
  },
  {
   "s": 60.3,
   "e": 62.74,
   "t": "It merely surrenders the vulnerable to the gathering darkness."
  },
  {
   "s": 63.76,
   "e": 65.54,
   "t": "Episode 4 of Amber Eyes."
  },
  {
   "s": 65.92,
   "e": 67.94,
   "t": "Watch the full documentary via the bio-link."
  }
 ]
}