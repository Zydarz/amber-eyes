 "segments": [
  {
   "s": 0.0,
   "e": 3.94,
   "t": "4つの初期警告サイン、犠牲者を二度と出さないために"
  },
  {
   "s": 3.94,
   "e": 8.28,
   "t": "第1の長行、幼少期のマクドナルドの3長行"
  },
  {
   "s": 8.68,
   "e": 13.48,
   "t": "10歳の頃から始まった意図的かつ、計画的な動物虐待"
  },
  {
   "s": 14.16,
   "e": 19.72,
   "t": "これは、共感能力の一尻しい欠助と暴力のエスカレーションを示す"
  },
  {
   "s": 19.72,
   "e": 22.54,
   "t": "見逃してはならない重大な警告でした"
  },
  {
   "s": 23.12,
   "e": 27.48,
   "t": "第2の長行、家庭内での極端な精神的虐待"
  },
  {
   "s": 28.08,
   "e": 33.0,
   "t": "子どもを閉鎖空間に隔離し、長期間に渡り尊厳を否定すること"
  },
  {
   "s": 33.46,
   "e": 38.1,
   "t": "Aさんの長行、現実から切り離された支配の妄想世界に"
  },
  {
   "s": 38.1,
   "e": 42.58,
   "t": "一人で深く没頭し、武器に異常な関心を持つこと"
  },
  {
   "s": 42.58,
   "e": 47.48,
   "t": "そして第4の長行、高い知性と感情の冷たさ"
  },
  {
   "s": 48.08,
   "e": 51.22,
   "t": "大人を言いまかし操る能力を持ちながら"
  },
  {
   "s": 51.22,
   "e": 53.3,
   "t": "他人の痛みに涙を流せないこと"
  },
  {
   "s": 54.1,
   "e": 58.78,
   "t": "エドマンドケンパーは天才的な 頭脳と体力を与えられながら逆体"
  },
  {
   "s": 58.78,
   "e": 63.66,
   "t": "の複数の中で破壊兵器へと 変貌しました悪を鉄防止の向こう"
  },
  {
   "s": 63.66,
   "e": 68.94,
   "t": "に閉じ込めるのは法の役目です しかし子どもの心の傷を家庭で"
  },
  {
   "s": 68.94,
   "e": 71.94,
   "t": "癒すことこそが悪を防ぐ唯一の 道です"
  },
  {
   "s": 72.58,
   "e": 77.1,
   "t": "アンバーアイズ第3話 事件の前方はバイオのリンク"
  },
  {
   "s": 77.1,
   "e": 78.14,
   "t": "からご覧いただけます"
  },
  {
   "s": 78.14,
   "e": 78.86,
   "t": "ご視聴ありがとうございました"
  }
