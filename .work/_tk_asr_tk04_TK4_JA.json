 "segments": [
  {
   "s": 0.0,
   "e": 4.78,
   "t": "ココノツの病院が彼を疑っていた しかし全員が沈黙を選んだ"
  },
  {
   "s": 5.32,
   "e": 9.4,
   "t": "アマセット医療センターは決して 最初の犯行現場ではなかったの"
  },
  {
   "s": 9.4,
   "e": 9.76,
   "t": "です"
  },
  {
   "s": 10.7,
   "e": 15.12,
   "t": "1988年から2003年までの16年間 に渡り"
  },
  {
   "s": 15.12,
   "e": 19.88,
   "t": "チャールスカレンはニュージャー g 州とペンシルベニア州にまたがる"
  },
  {
   "s": 20.4,
   "e": 24.22,
   "t": "ココノツの病院と一つの用語施設 を渡り歩いていました"
  },
  {
   "s": 24.84,
   "e": 27.62,
   "t": "あれが足を踏み入れたあらゆる 病院において"
  },
  {
   "s": 27.62,
   "e": 33.78,
   "t": "夜近時間帯の審定士による救世者の数は、異常な統計的羽上がりを示していました。"
  },
  {
   "s": 34.46,
   "e": 45.62,
   "t": "途中の病院で疑念が生じると、彼は秘密利に退職させられ、何の警告もない推薦状を手にして、次の病院へ移り、補食を再開していたのです。"
  },
  {
   "s": 45.62,
   "e": 57.92,
   "t": "しかし、液学調査データと原因不明の医薬品消失量に基づき、操作専門からは、実際の犠牲者が400名に達する可能性があると推計しています。"
  },
  {
   "s": 58.68,
   "e": 67.9,
   "t": "アンリシャたちの組織的な沈黙こそが、人を癒すべき病院を16年間もの間、強行の温症へと変貌させました。"
  },
  {
   "s": 68.62,
   "e": 74.14,
   "t": "2004年ニュージャージー周知事はこの 危険な沈黙の連鎖を永久に立ち切る"
  },
  {
   "s": 74.14,
   "e": 76.06,
   "t": "ため仮連法に署名しました"
  },
  {
   "s": 76.78,
   "e": 81.7,
   "t": "アンバーアイズ第4話プロフィール リンクから完全版ドキュメンタリー"
  },
  {
   "s": 81.7,
   "e": 82.34,
   "t": "をご覧ください"
  }
 ]
}