 "segments": [
  {
   "s": 0.52,
   "e": 4.42,
   "t": "8歳、食卓の下にあるお年度の地下室に閉じ込められた"
  },
  {
   "s": 4.84,
   "e": 11.54,
   "t": "エンパーの母、クラネルは息子の中に自分が荘をする元夫のおもかげを見ていました"
  },
  {
   "s": 12.14,
   "e": 20.2,
   "t": "8歳の頃から、江戸は石炭ストーブの隣の締めった地下室に追いやられ、その真上にはダイニングテーブルがありました"
  },
  {
   "s": 20.8,
   "e": 29.34,
   "t": "外に出るには、重い食卓を持ち上げなければならず、父親が警察に通報すると、おどすまで勘勤は続きました。"
  },
  {
   "s": 30.08,
   "e": 36.86,
   "t": "母親は毎日、彼の巨大な体格を罵倒し、自尊心を徹底的に踏みにじり続けました。"
  },
  {
   "s": 37.8,
   "e": 46.0,
   "t": "少年の無意識の中で、母親は憎しみながらも、決して逆らえない絶対的な権力の偶像と貸していったのです。"
  },
  {
   "s": 46.68,
   "e": 51.66,
   "t": "母親へ直接復習できない脳は 逃げのメカニズムを作動させ"
  },
  {
   "s": 51.66,
   "e": 57.42,
   "t": "大体の被害者を求め始めました お方に立つ若く美しい女子大生"
  },
  {
   "s": 57.42,
   "e": 63.02,
   "t": "たちは彼が活亡しながらも 母親と同じように自分を拒絶する"
  },
  {
   "s": 63.02,
   "e": 68.46,
   "t": "と信じた自由の象徴でした 不実の女性たちが彼が母親に"
  },
  {
   "s": 68.46,
   "e": 73.52,
   "t": "向けていた撮影の大理被害者として 犠牲となったのです医学的中期"
  },
  {
   "s": 73.52,
   "e": 79.14,
   "t": "精神会の間でも診断には議論 がありましたこれは行動を理解"
  },
  {
   "s": 79.14,
   "e": 85.12,
   "t": "するための理論的枠組みです アンバーアイズ第3話事件の前方"
  },
  {
   "s": 85.12,
   "e": 87.3,
   "t": "はバイオのリンクからご覧いただけ ます"
  }
 ]
}