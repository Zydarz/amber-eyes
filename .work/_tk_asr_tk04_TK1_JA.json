 "segments": [
  {
   "s": 0.0,
   "e": 3.76,
   "t": "劇薬を出庫し、わずか1秒後に取り消しボタンを押す"
  },
  {
   "s": 4.32,
   "e": 8.12,
   "t": "2000年代初頭、医薬品の厳格な追跡管理のため"
  },
  {
   "s": 8.62,
   "e": 14.3,
   "t": "病院軍は自動薬剤分配器、ピクシースメドステーションを導入し始めました"
  },
  {
   "s": 14.94,
   "e": 20.7,
   "t": "心がチャールスカレンは、このシステムのソフトウェア設計における重大な抜け穴を見つけ出しました"
  },
  {
   "s": 21.34,
   "e": 27.7,
   "t": "あれはディゴクシン、インスリン、ノレピネフリンといった劇薬の出庫を要求しますが"
  },
  {
   "s": 27.7,
   "e": 31.92,
   "t": "機械の引き出しが開いた瞬間に 取消しボタンを押したのです"
  },
  {
   "s": 32.5,
   "e": 37.58,
   "t": "コンピューターは取引をキャンセル済みと記録し 患者への請求は発生しませんが"
  },
  {
   "s": 38.02,
   "e": 41.8,
   "t": "劇薬のアンプルはすでに カレンのポケットへ収まっていました"
  },
  {
   "s": 42.52,
   "e": 46.92,
   "t": "アマセット病院に至ると カレンの抑制機能は完全に崩壊し"
  },
  {
   "s": 47.34,
   "e": 52.12,
   "t": "回復期にある 健康な若い患者までも無差別に標的としました"
  },
  {
   "s": 52.76,
   "e": 62.12,
   "t": "これに対し、心理的シグネチャ、反抗を突き動かした普遍の感情的欲求こそがまさに神コンプレックスでした。"
  },
  {
   "s": 62.8,
   "e": 74.3,
   "t": "誰を生かし、誰を終わらせるかを決定する権利を持つことで、彼は、自らが医学や運命すら超越した偉大な存在になったと錯覚しました。"
  },
  {
   "s": 75.18,
   "e": 79.96,
   "t": "アンバーアイズ第4話プロフィール リンクから完全版ドキュメンタリー"
  },
  {
   "s": 79.96,
   "e": 80.62,
   "t": "をご覧ください"
  }
 ]
}