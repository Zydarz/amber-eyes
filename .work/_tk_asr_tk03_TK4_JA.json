 "segments": [
  {
   "s": 0.0,
   "e": 4.58,
   "t": "i9-145 FBIの捜査手法を永遠に変えた図能"
  },
  {
   "s": 5.48,
   "e": 9.04,
   "t": "1978年 FBIの伝説的捜査官"
  },
  {
   "s": 9.04,
   "e": 11.72,
   "t": "ロバートレスラーとジョン・ダグラスが"
  },
  {
   "s": 11.72,
   "e": 13.84,
   "t": "バカビルの独暴に入りました"
  },
  {
   "s": 14.36,
   "e": 17.28,
   "t": "エンパーは山のように扉を塞ぎましたが"
  },
  {
   "s": 17.28,
   "e": 22.58,
   "t": "定長に微笑み 大学教授のような落ち着いた口調で語り始めました"
  },
  {
   "s": 23.16,
   "e": 27.42,
   "t": "i9-145を持つ彼は 原型も弁護士も求めず"
  },
  {
   "s": 27.78,
   "e": 32.02,
   "t": "ゲカイのような冷徹さで自らの 内面を解剖して見せました"
  },
  {
   "s": 32.6,
   "e": 36.24,
   "t": "エンパーはFBIに画期的な概念を 提示しました"
  },
  {
   "s": 36.84,
   "e": 39.52,
   "t": "それが暴力妄想のサイクルです"
  },
  {
   "s": 40.26,
   "e": 43.76,
   "t": "案在は狂気を手にした瞬間に 始まるのではなく"
  },
  {
   "s": 44.2,
   "e": 49.14,
   "t": "何年にも及ぶ数百回の頭の中で の横演習から始まります"
  },
  {
   "s": 49.72,
   "e": 53.94,
   "t": "千里品を集めた理由について 犯行後の興奮が消えた時"
  },
  {
   "s": 53.94,
   "e": 58.18,
   "t": "支配の会館を再び呼び起こすための 職売だと説明しました"
  },
  {
   "s": 58.78,
   "e": 64.74,
   "t": "ケンパーラ36人の副駅集との対話は FBIの質助型殺人犯の分類や"
  },
  {
   "s": 64.74,
   "e": 68.6,
   "t": "全国追跡システムVカップの石図へとなりました"
  },
  {
   "s": 69.1,
   "e": 74.26,
   "t": "現場には物理的証拠だけでなく 犯人特有の感情的欲求である"
  },
  {
   "s": 74.26,
   "e": 76.7,
   "t": "心理的署名が刻まれるのです"
  },
  {
   "s": 77.84,
   "e": 81.22,
   "t": "この記録は現代プロファイリングの 出発点となり"
  },
  {
   "s": 81.22,
   "e": 84.08,
   "t": "名作マインドハンターのモデルとなりました"
  },
  {
