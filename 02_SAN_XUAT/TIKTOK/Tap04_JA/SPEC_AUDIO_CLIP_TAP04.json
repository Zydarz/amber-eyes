          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "tk04_somerset_courtroom",
          "motion": "still",
          "text": "最大の生存の教訓：決して不正の前に沈黙してはならない。",
          "characters_spoken": 27,
          "est_dur_s": 4.02,
          "src_script": "hook — không phải dữ kiện kịch bản"
