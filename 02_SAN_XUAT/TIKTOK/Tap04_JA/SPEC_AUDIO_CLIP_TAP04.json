          "dur_s": 3.0
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK3.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "tk04_diner_exterior",
          "motion": "still",
          "text": "セーターの下の盗聴マイク。親友との命懸けのダイナー密会。",
          "characters_spoken": 28,
          "est_dur_s": 4.17,
          "src_script": "hook — không phải dữ kiện kịch bản"
        },
        {
          "clip_line_id": "TK3.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "tk04_diner_exterior",
          "motion": "pull",
          "text": "そして彼らが接触を図ったのが、優秀な夜勤看護師であり、Charles Cullenの無二の親友でもあったAmy Loughrenでした。",
          "characters_spoken": 66,
          "est_dur_s": 9.83,
          "src_script": "4.02#7"
        },
        {
          "clip_line_id": "TK3.01#3",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "tk04_diner_booth",
          "motion": "pan",
          "text": "我々が勤務時間外の小さなダイナーでAmy Loughrenと密会し、CullenのPyxis端末ログを目の前に広げた時、彼女は言葉を失いました。",
          "characters_spoken": 71,
          "est_dur_s": 11.54,
          "src_script": "4.04#1"
        },
        {
          "clip_line_id": "TK3.01#4",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "tk04_amy_scrubs",
          "motion": "still",
          "text": "事態をさらに過酷にしていたのは、彼女が重度の心筋症を患い、幼い二人の娘を女手一つで育てていたという個人的な境遇でした。",
          "characters_spoken": 59,
          "est_dur_s": 9.59,
          "src_script": "4.04#6"
        },
        {
          "clip_line_id": "TK3.01#5",
          "role": "N2",
          "emotion": "fearful",
          "speed_offset": -0.04,
          "pause_after_s": 0.7,
          "bg": "tk04_amy_scrubs",
          "motion": "push",
          "text": "自分の命や娘たちの未来を思うと恐怖で震えましたが、沈黙を守り凶行を見過ごすことなど私にはできませんでした。",
          "characters_spoken": 53,
          "est_dur_s": 8.48,
          "src_script": "4.06#6"
        },
        {
          "clip_line_id": "TK3.01#6",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "tk04_wire_closeup",
          "motion": "push",
          "text": "Amy Loughrenは、州捜査官たちによって冬のセーターの内側に仕掛けられた盗聴マイクを身につけて店内へ入りました。",
          "characters_spoken": 59,
          "est_dur_s": 8.79,
          "src_script": "4.08#3"
        },
        {
          "clip_line_id": "TK3.01#7",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "tk04_diner_booth",
          "motion": "still",
          "text": "Amyは卓越した共感力と心理的誘導を用い、病院内の動揺を語りかけながら、彼に自首を優しく促しました。",
          "characters_spoken": 50,
          "est_dur_s": 7.45,
          "src_script": "4.08#6"
        },
        {
          "clip_line_id": "TK3.01#8",
          "role": "H",
          "emotion": "sad",
          "speed_offset": -0.03,
          "pause_after_s": 0.7,
          "bg": "tk04_diner_booth",
          "motion": "pull",
          "text": "彼はテーブルの上に深く頭を垂れ、録音テープに明確に残る声でこう囁いたのです――「やめたい、すべてを終わりにしたい。」",
