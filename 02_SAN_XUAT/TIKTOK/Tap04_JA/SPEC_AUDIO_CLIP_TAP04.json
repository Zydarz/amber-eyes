        {
          "clip_line_id": "TK5.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "tk04_boardroom_empty",
          "motion": "pan",
          "text": "同時に私たちは、凶行そのものよりも痛烈な真実――損害賠償訴訟と法的責任への恐怖から9つの病院が沈黙を守り続けた組織の共犯構造を暴きます。",
          "characters_spoken": 68,
          "est_dur_s": 10.13,
          "src_script": "1.16#4"
