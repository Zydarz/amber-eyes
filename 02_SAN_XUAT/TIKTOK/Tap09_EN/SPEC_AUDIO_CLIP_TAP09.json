          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#4",
          "text": "KURT LEWIN’S THREE-STAGE BRAINWASHING MODEL",
          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#6",
          "text": "LOVE BOMBING TACTIC OVERWHELMING DEFENSES",
          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#8",
