          "dur_s": 3.0
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK3.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t9_yearbook_photos_shadow",
          "motion": "pull",
          "text": "Church choir singers, model high school sweethearts. Why did they become ruthless killing machines?",
          "est_dur_s": 5.0,
          "src_script": "Hook mở đầu — tạo tò mò",
          "words_spoken": 14
        },
        {
          "clip_line_id": "TK3.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_runaway_teenager_bus_stop",
          "motion": "still",
          "text": "Accompanying him were young women originating from respectable, middle-class suburban households.",
          "est_dur_s": 3.9,
          "src_script": "3.02#3",
          "words_spoken": 11
        },
        {
          "clip_line_id": "TK3.01#3",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_yearbook_photos_shadow",
          "motion": "push",
          "text": "Susan Atkins had sung in her local church choir, Patricia Krenwinkel was known for her gentleness, and Leslie Van Houten had been a former high school homecoming princess.",
          "est_dur_s": 9.9,
          "src_script": "3.02#4",
          "words_spoken": 28
        },
        {
          "clip_line_id": "TK3.01#4",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_kurt_lewin_three_stages_diagram",
          "motion": "pan",
          "text": "To demystify this terrifying transformation, we must examine social psychologist Kurt Lewin's three-stage change paradigm, later adapted by Professor Edgar Schein to explain brainwashing:",
          "est_dur_s": 9.7,
          "src_script": "3.03#1",
          "words_spoken": 24
        },
        {
          "clip_line_id": "TK3.01#5",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_kurt_lewin_three_stages_diagram",
          "motion": "still",
          "text": "Namely: Unfreezing the existing self, Changing cognitive perceptions, and Refreezing newly conditioned behavior.",
          "est_dur_s": 5.3,
          "src_script": "3.03#2",
          "words_spoken": 13
        },
        {
          "clip_line_id": "TK3.01#6",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_unfreezing_love_bombing_circle",
          "motion": "pull",
          "text": "Whenever a vulnerable newcomer crossed the threshold of Spahn Ranch, Manson immediately unleashed aggressive “Love Bombing”.",
          "est_dur_s": 5.7,
          "src_script": "3.05#2",
          "words_spoken": 16
        },
        {
          "clip_line_id": "TK3.01#7",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_two_faced_benevolent_mask",
          "motion": "push",
          "text": "He embraced them warmly, stared into their eyes, and proclaimed they were flawless beings.",
          "est_dur_s": 5.0,
          "src_script": "3.05#3",
          "words_spoken": 14
        },
        {
          "clip_line_id": "TK3.01#8",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_burning_id_cards_ashes",
          "motion": "pan",
          "text": "Manson demanded that recruits discard their money, surrender identification papers, and cut off all communication with their parents.",
          "est_dur_s": 7.3,
          "src_script": "3.06#2",
          "words_spoken": 18
        },
        {
          "clip_line_id": "TK3.01#9",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_vacant_eyes_doll_shadow",
          "motion": "still",
          "text": "He stripped away their birth names, assigning them bizarre aliases like Sadie, Katie, or Lulu to erase their historical identities.",
          "est_dur_s": 8.1,
          "src_script": "3.06#3",
          "words_spoken": 20
        },
        {
          "clip_line_id": "TK3.01#10",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.0,
          "bg": "t9_amber_eyes_closing_dossier",
          "motion": "still",
          "text": "Episode nine of Amber Eyes. Watch the full documentary at the link in bio.",
          "est_dur_s": 5.0,
          "src_script": "CTA — kêu gọi xem tập đầy đủ",
          "words_spoken": 14
        }
      ]
