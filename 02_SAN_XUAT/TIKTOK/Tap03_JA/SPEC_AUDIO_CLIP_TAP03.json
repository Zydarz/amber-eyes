          "dur_s": 2.5
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK3.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t3_basement_stairs",
          "motion": "still",
          "text": "8歳。食卓の下にある落とし戸の地下室に閉じ込められた。",
          "characters_spoken": 27,
          "est_dur_s": 4.09,
          "src_script": "3.05#6 · 3.05#7"
        },
        {
          "clip_line_id": "TK3.01#2",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_coal_furnace",
          "motion": "push",
          "text": "ケンパーの母クラネルは、息子の中に自分が憎悪する元夫の面影を見ていました。",
          "characters_spoken": 37,
          "est_dur_s": 6.3,
          "src_script": "3.05#4 · 3.05#5"
        },
        {
          "clip_line_id": "TK3.01#3",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_small_bed",
          "motion": "still",
          "text": "8歳の頃から、エドは石炭ストーブの隣の湿った地下室に追いやられ、その真上にはダイニングテーブルがありました。",
          "characters_spoken": 54,
          "est_dur_s": 9.2,
          "src_script": "3.05#6 · 3.05#7"
        },
        {
          "clip_line_id": "TK3.01#4",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_trapdoor",
          "motion": "pull",
          "text": "外に出るには重い食卓を持ち上げなければならず、父親が警察に通報すると脅すまで監禁は続きました。",
          "characters_spoken": 47,
          "est_dur_s": 8.0,
          "src_script": "3.05#7 · 3.05#8"
        },
        {
          "clip_line_id": "TK3.01#5",
          "role": "C",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.7,
          "bg": "t3_basement_stairs",
          "motion": "pan",
          "text": "母親は毎日、彼の巨大な体格を罵倒し、自尊心を徹底的に踏みにじり続けました。",
          "characters_spoken": 37,
          "est_dur_s": 6.3,
          "src_script": "3.05#9 · 3.05#12"
        },
        {
          "clip_line_id": "TK3.01#6",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_mother_shadow",
          "motion": "still",
          "text": "少年の無意識の中で、母親は憎しみながらも決して逆らえない絶対的な権力の偶像と化していったのです。",
          "characters_spoken": 48,
          "est_dur_s": 8.17,
          "src_script": "3.08#6"
        },
        {
          "clip_line_id": "TK3.01#7",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_ucsc_campus",
          "motion": "push",
          "text": "母親へ直接復讐できない脳は、投影のメカニズムを作動させ、代替の被害者を求め始めました。",
          "characters_spoken": 43,
          "est_dur_s": 7.32,
          "src_script": "3.08#1 · 3.08#7 · 3.08#11"
        },
        {
          "clip_line_id": "TK3.01#8",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_hitchhiker",
          "motion": "pull",
          "text": "路肩に立つ若く美しい女子大生たちは、彼が渇望しながらも、母親と同じように自分を拒絶すると信じた自由の象徴でした。",
          "characters_spoken": 56,
          "est_dur_s": 9.54,
