        "fx_stinger.wav"
      ],
      "overlays": [
        {
          "after_id": "TK2.01#1",
          "text": "バー「THE JURY ROOM」 · 地方裁判所の真正面",
          "dur_s": 3.0
        },
        {
          "after_id": "TK2.01#3",
          "text": "2m06 · 127kg · メガネ · 紳士的で温厚な語り口",
          "dur_s": 2.5
        },
        {
          "after_id": "TK2.01#5",
          "text": "黄色いフォードに貼られた大学職員ステッカー",
          "dur_s": 2.5
        },
        {
          "after_id": "TK2.01#7",
          "text": "捜査員に犯人の心理プロファイルをアドバイス",
          "dur_s": 3.0
        },
        {
          "after_id": "TK2.01#9",
          "text": "知性のハロー効果（組織の心理的盲点）",
          "dur_s": 2.5
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK2.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t3_bar_stool_shadow",
          "motion": "still",
          "text": "警察官とビールを飲み、自らの事件について語る。",
          "characters_spoken": 23,
          "est_dur_s": 3.48,
          "src_script": "1.03#7 · 2.09#8 · 2.09#9"
        },
        {
          "clip_line_id": "TK2.01#2",
          "role": "N2",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_bar_jury_room",
          "motion": "pull",
          "text": "サンタクルーズ裁判所の真正面にあるバー「The Jury Room」は、当直を終えた刑事や警察官が集まる行きつけの店でした。",
          "characters_spoken": 60,
          "est_dur_s": 8.48,
          "src_script": "2.09#1"
        },
        {
          "clip_line_id": "TK2.01#3",
          "role": "N2",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_bar_stool_shadow",
          "motion": "pan",
          "text": "ビッグ・エドはいつもバーの隅の席に座っていました。身長2メートル06、メガネをかけ、法律に詳しく非常に礼儀正しい男でした。",
          "characters_spoken": 61,
          "est_dur_s": 8.62,
          "src_script": "1.03#6 · 2.07#12 · 2.09#2 · 2.09#3"
        },
        {
          "clip_line_id": "TK2.01#4",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_galaxie",
          "motion": "still",
          "text": "昼間、彼はバンパーに大学職員用駐車ステッカーを貼った、1969年型の黄色いフォード・ギャラクシーを運転していました。",
          "characters_spoken": 58,
          "est_dur_s": 9.43,
          "src_script": "2.07#2 · 2.07#3 · 2.07#4"
        },
        {
          "clip_line_id": "TK2.01#5",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_hitchhiker",
          "motion": "push",
          "text": "大学のステッカーと知的で物静かな外見は、ヒッチハイクをする女子学生たちに絶対的な安心感を与えていたのです。",
          "characters_spoken": 53,
          "est_dur_s": 8.61,
          "src_script": "2.07#5 · 2.07#10 · 2.07#12"
        },
        {
          "clip_line_id": "TK2.01#6",
          "role": "N2",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.8,
          "bg": "t3_bar_jury_room",
          "motion": "still",
          "text": "刑事たちがエドと一緒にビールを飲みながら、女子大生殺人鬼の捜査が難航している苦悩を打ち明ける夜もありました。",
          "characters_spoken": 54,
          "est_dur_s": 7.63,
          "src_script": "2.09#6"
        },
        {
          "clip_line_id": "TK2.01#7",
          "role": "N2",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.8,
          "bg": "t3_bar_stool_shadow",
          "motion": "push",
          "text": "エドは相槌を打ちながら分析し、犯人の心理について鋭い仮説を捜査員たちに助言してくれたのです。",
          "characters_spoken": 46,
          "est_dur_s": 6.5,
          "src_script": "2.09#7"
        },
        {
          "clip_line_id": "TK2.01#8",
          "role": "N2",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.7,
          "bg": "t3_bar_stool_shadow",
          "motion": "pull",
          "text": "思い返すと背筋が凍ります。街中が必死に追っていた怪物が、私たちの隣で捜査について笑っていたのです。",
          "characters_spoken": 49,
          "est_dur_s": 6.93,
          "src_script": "2.09#8 · 2.09#9"
        },
        {
          "clip_line_id": "TK2.01#9",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_brain_mirror",
          "motion": "still",
          "text": "ハロー効果。卓越した知性と温厚な態度は、法執行機関そのものを欺く不可視の偽装壁となったのです。",
          "characters_spoken": 47,
          "est_dur_s": 8.0,
          "src_script": "2.07#10 · 5.06#3 · 5.06#4"
        },
        {
          "clip_line_id": "TK2.01#10",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.0,
          "bg": "t3_closing_desk",
          "motion": "still",
          "text": "Amber Eyes 第3話。事件の全貌はバイオのリンクからご覧いただけます。",
          "characters_spoken": 37,
          "est_dur_s": 5.6,
          "src_script": "CTA"
        }
      ]
    },
    "TK3": {
