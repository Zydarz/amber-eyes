      "overlays": [
        {
          "after_id": "TK3.01#1",
          "text": "モンタナ州の地下室 · 1950年代の幼少期",
          "dur_s": 3.0
        },
        {
          "after_id": "TK3.01#3",
          "text": "ダイニングテーブルの真下にある落とし戸",
