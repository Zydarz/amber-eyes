        {
          "clip_line_id": "TK3.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "tk02_two_masks",
          "motion": "pull",
          "text": "分析の前提：公的な臨床診断はありません。これは犯罪心理学の理論モデルです。",
          "characters_spoken": 37,
          "est_dur_s": 5.77,
