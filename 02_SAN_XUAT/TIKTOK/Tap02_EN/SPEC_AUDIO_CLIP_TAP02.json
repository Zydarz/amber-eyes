      ],
      "overlays": [
        {
          "after_id": "TK3.01#3",
          "text": "COMPARTMENTALIZATION: SPLITTING THE PSYCHE",
          "dur_s": 3.0
        },
        {
          "after_id": "TK3.01#4",
          "text": "DRAWER ONE — THE IMMACULATE COLONEL",
          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#5",
          "text": "DRAWER TWO — THE SHADOW PREDATOR",
          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#7",
          "text": "TECHNIQUES OF NEUTRALIZATION",
          "dur_s": 3.0
        },
        {
          "after_id": "TK3.01#8",
          "text": "“JUST A SOUVENIR”",
          "dur_s": 2.5
        },
        {
          "after_id": "TK3.01#10",
