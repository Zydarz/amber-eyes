      ],
      "overlays": [
        {
          "after_id": "TK4.01#1",
          "text": "NOT A SINGLE WORD OF REMORSE FOR THE VICTIMS",
          "dur_s": 3.0
        },
        {
          "after_id": "TK4.01#3",
          "text": "NOT REPENTANCE — PATHOLOGICAL SELF-PITY",
          "dur_s": 2.5
        },
        {
          "after_id": "TK4.01#4",
          "text": "GUILTY ON ALL 88 CHARGES",
          "dur_s": 2.5
        },
        {
          "after_id": "TK4.01#5",
          "text": "CONCURRENT LIFE SENTENCES · 25 YEARS NO PAROLE",
          "dur_s": 2.5
        },
        {
          "after_id": "TK4.01#7",
          "text": "BURNING EVERY UNIFORM BEARING HIS NAME",
          "dur_s": 2.5
