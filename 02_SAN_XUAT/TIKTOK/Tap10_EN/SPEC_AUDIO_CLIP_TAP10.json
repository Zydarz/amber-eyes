      "lines": [
        {
          "line_id": "TK1.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.5,
          "text": "A young mother smiling with a baby in a van. Who could guess it was the start of a seven-year nightmare?",
          "bg": "t10_blue_dodge_van_approaching",
          "motion": "pull",
          "source": "Hook mở đầu — tạo tò mò"
        },
        {
          "line_id": "TK1.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "Inside the vehicle sat not a solitary suspicious man, but a youthful married couple roughly her own age.",
          "bg": "t10_innocent_family_facade",
          "motion": "push",
          "source": "1.06#2"
        },
        {
          "line_id": "TK1.01#3",
          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
