          "motion": "pan",
          "source": "1.06#4"
        },
        {
          "line_id": "TK1.01#5",
          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "Colleen smiled and stepped inside the van, unaware that this single step crossed the threshold into a nightmare lasting more than seven years.",
          "bg": "t10_knife_shadow_ambush",
          "motion": "push",
          "source": "1.06#6"
        },
        {
          "line_id": "TK1.01#6",
          "role": "D",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "He forced a custom-crafted soundproof wooden box lined with thick foam over Colleen's head.",
          "bg": "t10_soundproof_headbox_forensic",
          "motion": "pull",
          "source": "1.10#3"
        },
        {
          "line_id": "TK1.01#7",
          "role": "D",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "This headbox weighed nearly twenty pounds, entirely severing all visual light and ambient sound from the surrounding world.",
          "bg": "t10_soundproof_headbox_forensic",
          "motion": "still",
          "source": "1.10#4"
        },
        {
          "line_id": "TK1.01#8",
          "role": "D",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "The fact that this box was constructed months in advance proved that this abduction was no impulsive act.",
