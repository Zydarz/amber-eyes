  "clips": {
    "TK1": {
      "title": "The Family Van Trap & The 9kg Soundproof Headbox",
      "estimated_duration": 69.3,
      "bgm": "bgm_cello_sad.mp3",
      "sfx": [
        "amb_highway_distant.wav (bed)",
        "fx_tension_tick.wav",
        "fx_stinger.wav"
