          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "There, she was locked inside a cramped wooden box concealed beneath the waterbed in the couple's master bedroom.",
          "bg": "t10_wooden_box_under_bed_shadow",
          "motion": "push",
