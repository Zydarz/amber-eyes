        {
          "line_id": "TK4.01#7",
          "role": "H",
          "emotion": "neutral",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "Janice realized that continuing silence would bury not only Colleen, but the future of her own young daughters in an abyss of criminality.",
          "bg": "t10_seventh_year_toddler_toys_shadow",
          "motion": "pull",
          "source": "4.04#4"
        },
        {
          "line_id": "TK4.01#8",
          "role": "N2",
          "emotion": "fearful",
          "speed": -0.02,
          "pause_after": 0.6,
          "text": "But seeing that ravenous predatory hunger in his eyes, watching my two toddler daughters playing innocently on the rug, a cold truth seized me: This monster will never stop.",
          "bg": "t10_janice_hooker_moral_turmoil",
          "motion": "pan",
          "source": "4.05#4"
        },
