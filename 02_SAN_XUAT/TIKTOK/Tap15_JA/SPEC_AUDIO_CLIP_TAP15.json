      "fx_car_driving_night.wav",
      "fx_stinger.wav"
    ],
    "overlay": [
      {
        "after_id": "TK2.01#1",
        "text": "2008年6月2日：カリフォルニア州レディングでレンタカー確保",
        "dur_s": 2.5
      },
      {
        "after_id": "TK2.01#3",
        "text": "アリゾナでのカード履歴を避けるための3つのガソリン携行缶",
        "dur_s": 3.0
      },
      {
        "after_id": "TK2.01#4",
        "text": "突発的発作を完全に否定する周到な計画性",
        "dur_s": 2.5
      },
      {
        "after_id": "TK2.01#6",
        "text": "黒髪への偽装染色と携帯電話基地局追跡の遮断",
        "dur_s": 2.5
      },
      {
        "after_id": "TK2.01#8",
        "text": "綿密に組み立てられた戦慄のアリバイ工作",
        "dur_s": 3.0
      }
    ],
    "lines": [
      {
        "id": "TK2.01#1",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "2008年6月2日、Jodiはカリフォルニア州レディング（Redding）にてレンタカーを1台調達しました。",
        "source": "2.05#5",
        "bg": "t15_darryl_brewer_garage_gas_cans",
        "camera": "still",
        "dur_est": 8.86
      },
      {
        "id": "TK2.01#2",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "彼女は知人から予備の燃料缶2個を借り受け、さらに大型店舗で3つ目の燃料缶を追加購入していました。",
        "source": "2.05#6",
        "bg": "t15_jodi_arias_a2_10_bpd",
        "camera": "push",
        "dur_est": 7.88
      },
      {
        "id": "TK2.01#3",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "3つの予備燃料缶を積載することで、彼女はアリゾナ州内でクレジットカード記録を一切残さずに砂漠地帯を往復できたのです。",
        "source": "2.05#7",
        "bg": "t15_jodi_arias_a2_11_abandonment",
        "camera": "pan",
        "dur_est": 9.52
      },
      {
        "id": "TK2.01#4",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "この犯行手口（MO）は、出発前から極めて冷酷かつ計画的にアリバイが偽装されていたことを如実に物語っています。",
        "source": "2.05#8",
        "bg": "t15_b25_darryl_brewer_garage_gas_can",
        "camera": "pull",
        "dur_est": 8.86
      },
      {
        "id": "TK2.01#5",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "旅に出る直前、Jodiは外見の印象を変えるために髪を暗い茶色へと染め替えていました。",
        "source": "2.05#9",
        "bg": "t15_interstate_highway_gas_stop_midnight",
        "camera": "still",
        "dur_est": 6.89
      },
      {
        "id": "TK2.01#6",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "アリゾナ州内を移動する間、彼女は基地局による位置追跡を回避するため、携帯電話の電源を意図的に切断していました。",
        "source": "2.05#10",
        "bg": "t15_salt_lake_city_suburban_doorstep",
        "camera": "push",
        "dur_est": 9.02
      },
      {
        "id": "TK2.01#7",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "彼女は自分がまだ彼を探しているかのように装うため、Travisの留守番電話に優しいメッセージを吹き込みさえしたのです。",
        "source": "2.05#13",
        "bg": "t15_b62_jodi_arias_a2_02_photographs",
        "camera": "still",
        "dur_est": 9.68
      },
      {
        "id": "TK2.01#8",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.0,
        "text": "これは突発的なパニックによる反応などではなく、綿密に練り上げられたシナリオに基づくアリバイ工作だったのです。",
        "source": "2.05#16",
        "bg": "t15_jodi_arias_a2_05_mesa",
        "camera": "pull",
        "dur_est": 8.86
      }
    ]
  },
  "TK3": {
    "title": "境界性パーソナリティ障害（BPD）と見捨てられ不安の暴走",
    "theme": "境界性パーソナリティ障害のスプリッティングと激しい怒り",
    "hook": "朝の崇拝から夕方の破壊願望へ。境界性パーソナリティ障害（BPD）が引き起こす激動の深層心理。",
    "total_dur_est": 81.6,
    "bgm": "bgm_piano_minimal.mp3",
    "sfx": [
      "amb_room_tone.wav（環境音）",
      "fx_clock_ticking.wav",
      "fx_stinger.wav"
    ],
    "overlay": [
      {
        "after_id": "TK3.01#1",
        "text": "法廷で提出された臨床精神医学鑑定書",
        "dur_s": 2.5
      },
      {
        "after_id": "TK3.01#2",
        "text": "境界性パーソナリティ障害（BPD）の診断",
        "dur_s": 3.0
      },
      {
        "after_id": "TK3.01#4",
        "text": "狂気じみた「見捨てられ不安」がもたらす自己崩壊",
        "dur_s": 2.5
      },
      {
        "after_id": "TK3.01#6",
        "text": "スプリッティング：全か無か、理想化から悪魔化へ",
        "dur_s": 3.0
      },
      {
        "after_id": "TK3.01#8",
        "text": "トラウマ性愛着が引き起こした破滅的凶行",
        "dur_s": 3.0
      }
    ],
    "lines": [
      {
        "id": "TK3.01#1",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "精密な精神鑑定の結果、Jodi Ariasは悪性自己愛が結合した境界性パーソナリティ障害の典型的な特徴を示していると結論づけられました。",
        "source": "3.04#1",
        "bg": "t15_jodi_arias_a3_03_arizona",
        "camera": "push",
        "dur_est": 10.26
      },
      {
        "id": "TK3.01#2",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "これは現実の認識能力を失う精神障害ではなく、思考と感情のシステムが深刻に歪曲された人格構造です。",
        "source": "3.04#2",
        "bg": "t15_jodi_arias_a3_04_desert",
        "camera": "pan",
        "dur_est": 7.35
      },
      {
        "id": "TK3.01#3",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "境界性パーソナリティ障害は、自己像、感情の制御、そして対人関係全般における極度の不安定性を本質的な特徴とします。",
        "source": "3.05#1",
        "bg": "t15_jodi_arias_a3_06_gascan",
        "camera": "still",
        "dur_est": 9.31
      },
      {
        "id": "TK3.01#4",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "この特性を持つ者の行動を支配する最も根源的な原動力は、現実のものであれ想像上のものであれ、見捨てられることに対する耐え難い恐怖です。",
        "source": "3.05#2",
        "bg": "t15_jodi_arias_a3_07_bpd",
        "camera": "push",
        "dur_est": 10.97
      },
      {
        "id": "TK3.01#5",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "彼らにとって恋人からの拒絶は単なる失恋の痛手ではなく、自己そのものが消滅するような壊滅的危機として体験されます。",
        "source": "3.05#3",
        "bg": "t15_jodi_arias_a3_08_abandonment",
        "camera": "pan",
        "dur_est": 9.31
      },
      {
        "id": "TK3.01#6",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "彼らの内面世界は絶対的な二者択一へと分極化します：すなわち、完璧な救済者であるか、あるいは完全なる悪人であるかのどちらかです。",
        "source": "3.05#5",
        "bg": "t15_b67_borderline_splitting_black_w",
        "camera": "still",
        "dur_est": 10.47
      },
      {
        "id": "TK3.01#7",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "独占的支配の幻想が崩壊したことで、「境界性の激怒（Borderline Rage）」という極端な破壊エネルギーが解き放たれました。",
        "source": "3.05#10",
        "bg": "t15_trauma_bonding_push_pull_tangle",
        "camera": "push",
        "dur_est": 10.64
      },
      {
        "id": "TK3.01#8",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.0,
        "text": "境界性と自己愛の特質の結合は、彼女の中に世間の注目の中心であり続けたいという飽くなき渇望を生み出していました。",
        "source": "3.11#1",
        "bg": "t15_b63_cognitive_dissonance_scriptu",
        "camera": "push",
        "dur_est": 9.14
      }
    ]
  },
  "TK4": {
    "title": "取調室の三面記事的茶番と全米中継法廷",
    "theme": "中和の技術（自己正当化）と病的自己憐憫の仮面",
    "hook": "取調室での逆立ち、二転三転する供述。法廷で見せた涙は真の悔悟か、それとも計算された演技か？",
    "total_dur_est": 79.3,
    "bgm": "bgm_violin_heart.mp3",
    "sfx": [
      "amb_wind_cold.wav（環境音）",
      "fx_camera_flash_crowd.wav",
      "fx_stinger.wav"
    ],
    "overlay": [
      {
        "after_id": "TK4.01#1",
        "text": "最初の嘘：「事件当時はアリゾナにいなかった」",
        "dur_s": 2.5
      },
      {
        "after_id": "TK4.01#3",
        "text": "覆面強盗2人組による襲撃という荒唐無稽な作り話",
        "dur_s": 2.5
      },
      {
        "after_id": "TK4.01#5",
        "text": "取調室の監視カメラの前で見せた逆立ちと独唱の奇行",
        "dur_s": 3.0
      },
      {
        "after_id": "TK4.01#6",
        "text": "2013年：全米が熱狂した生中継センセーション裁判",
        "dur_s": 2.5
      },
      {
        "after_id": "TK4.01#8",
        "text": "仮面が剥がれ落ちた後の病的自己憐憫の涙",
        "dur_s": 3.0
      }
    ],
    "lines": [
      {
        "id": "TK4.01#1",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "捜査官に対するJodi Ariasの最初の供述は、2008年4月以降アリゾナの地を踏んだことすらないという完全な否認でした。",
        "source": "2.08#1",
        "bg": "t15_b41_jodi_arias_a2_11_abandonment",
        "camera": "pull",
        "dur_est": 10.01
      },
      {
        "id": "TK4.01#2",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "しかし洗濯機のメモリカードから復元された写真が眼前に突きつけられると、その虚偽は瞬く間に瓦解しました。",
        "source": "2.08#2",
        "bg": "t15_b26_darryl_brewer_garage_gas_can",
        "camera": "still",
        "dur_est": 8.37
      },
      {
        "id": "TK4.01#3",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "彼女は仮面をかぶった2人組の暴漢が侵入して2人を制圧したという、荒唐無稽な筋書きへと即座に供述を変更したのです。",
        "source": "2.08#3",
        "bg": "t15_b17_interstate_highway_gas_stop_",
        "camera": "push",
        "dur_est": 9.19
      },
      {
        "id": "TK4.01#4",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "司法手続きが進行する間、Jodi Ariasは捜査当局の前で公式供述を3度にわたって翻しました。",
        "source": "4.07#1",
        "bg": "t15_b18_jodi_arias_a4_09_interrogati",
        "camera": "pan",
        "dur_est": 7.2
      },
      {
        "id": "TK4.01#5",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "アリゾナ訪問そのものを否定した最初の供述から、覆面の暴漢による襲撃説を経て、正当防衛を主張する最終供述へと至りました。",
        "source": "4.07#2",
        "bg": "t15_jodi_arias_a4_10_mesa",
        "camera": "pull",
        "dur_est": 9.04
      },
      {
        "id": "TK4.01#6",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
