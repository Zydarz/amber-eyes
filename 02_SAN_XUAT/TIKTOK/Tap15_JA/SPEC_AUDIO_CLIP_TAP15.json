{
  "TK1": {
    "title": "洗濯機の謎と復元されたデジタル鑑識データ",
    "theme": "手口MO対署名Signatureとデジタルフォレンジックの決定打",
    "hook": "証拠隠滅のため洗濯機に沈められたカメラ。しかしデジタル鑑識は嘘をつかない。",
    "total_dur_est": 73.0,
    "bgm": "bgm_cello_sad.mp3",
    "sfx": [
