      "fx_camera_shutter.wav",
      "fx_stinger.wav"
    ],
    "overlay": [
      {
        "after_id": "TK1.01#1",
        "text": "アリゾナ州メサの現場 · 2008年夏",
        "dur_s": 2.5
      },
      {
        "after_id": "TK1.01#3",
        "text": "水が回る洗濯機の底に沈められたソニー製カメラ",
        "dur_s": 3.0
      },
      {
        "after_id": "TK1.01#5",
        "text": "消去された写真群が秒単位で完全復元される",
        "dur_s": 3.0
      },
      {
        "after_id": "TK1.01#7",
        "text": "午後5時29分：浴室で撮影された最後の写真",
        "dur_s": 2.5
      },
      {
        "after_id": "TK1.01#9",
        "text": "第三者の関与を完全に否定したデジタル鑑識の証拠",
        "dur_s": 3.0
      }
    ],
    "lines": [
      {
        "id": "TK1.01#1",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "しかし最も異様な違和感は、階下に位置する洗濯室の中で発見されたのです。",
        "source": "1.14#3",
        "bg": "t15_jodi_arias_a1_08_mesa",
        "camera": "still",
        "dur_est": 5.36
      },
      {
        "id": "TK1.01#2",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "洗濯槽の中では、被害者の寝具類と共に濡れた衣類が回されていました。",
        "source": "1.14#4",
        "bg": "t15_b03_washing_machine_running_dark",
        "camera": "push",
        "dur_est": 5.05
      },
      {
        "id": "TK1.01#3",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "そして水浸しになった槽の底から見つかったのは、Travisが所持していたソニー（Sony）製のデジタルカメラでした。",
        "source": "1.14#5",
        "bg": "t15_b03_washing_machine_running_dark",
        "camera": "pan",
        "dur_est": 8.88
      },
      {
        "id": "TK1.01#4",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "加害者は浸水によって内部の電子データが永久に破壊されることを狙い、カメラを洗濯機の中に投入したのです。",
        "source": "1.14#6",
        "bg": "t15_b03_washing_machine_running_dark",
        "camera": "pull",
        "dur_est": 7.81
      },
      {
        "id": "TK1.01#5",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "手作業で消去されていた膨大な写真群が、秒単位の正確な時系列に沿って克明に復元されました。",
        "source": "2.04#1",
        "bg": "t15_jodi_arias_a2_03_mirror",
        "camera": "still",
        "dur_est": 6.74
      },
      {
        "id": "TK1.01#6",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "2008年6月4日の午後に撮影された写真群は、Travis AlexanderとJodi Ariasが家の中で共に過ごしていた事実を証明していました。",
        "source": "2.04#2",
        "bg": "t15_jodi_arias_a2_04_interrogation",
        "camera": "push",
        "dur_est": 11.18
      },
      {
        "id": "TK1.01#7",
        "role": "H",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "Travisが生きてカメラに収められた最後の姿は、同日午後5時29分、浴室の中で記録されたものでした。",
        "source": "2.04#3",
        "bg": "t15_jodi_arias_a2_05_mesa",
        "camera": "pan",
        "dur_est": 7.81
      },
      {
        "id": "TK1.01#8",
        "role": "H",
        "emotion": "fearful",
        "speed": -0.03,
        "pause_after": 0.6,
        "text": "そしてそのわずか数分後、カメラは現場に存在するJodi Ariasの姿を偶然にも捉えていたのです。",
        "source": "2.04#4",
        "bg": "t15_jodi_arias_a2_06_arizona",
        "camera": "pull",
        "dur_est": 7.35
      },
      {
        "id": "TK1.01#9",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.0,
        "text": "復元されたデジタル画像データは、その運命の時刻に現場へ第三者が侵入した可能性を完全に粉砕しました。",
        "source": "2.05#1",
        "bg": "t15_jodi_arias_a2_07_desert",
        "camera": "still",
        "dur_est": 8.04
      }
    ]
  },
  "TK2": {
    "title": "砂漠越えのルートと3つの秘密のガソリン携行缶",
    "theme": "周到な事前計画と電子足跡の組織的隠蔽手口",
    "hook": "黒染めした髪、切られた携帯電源、3つのガソリン缶。戦慄の完全犯罪計画。",
    "total_dur_est": 73.8,
    "bgm": "bgm_ambient_deep.mp3",
    "sfx": [
