        "dur_est": 9.74
      },
      {
        "id": "TK4.01#8",
        "role": "C",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.0,
        "text": "彼女が流したすべての涙は、自身の不遇な運命と失われた名声に対する悔しさにのみ向けられていたのです。",
        "source": "4.11#3",
        "bg": "t14_b4_handprint_fogged_prison_glass",
        "camera": "pull",
        "dur_est": 8.53
      }
