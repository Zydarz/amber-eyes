        "id": "TK4.01#7",
        "role": "D",
        "emotion": "neutral",
        "speed": -0.02,
        "pause_after": 0.6,
        "text": "同時に私たちは、事件前後にジェニファーとダニエル・ウォンの間で交わされた膨大なテキストメッセージの通信記録を机上に並べました。",
        "source": "4.08#4",
        "bg": "t13_forensic_cellphone_text_evidence",
        "camera": "pull",
        "dur_est": 10.67
      },
