          "dur_s": 3.0
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK1.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t3_phone_booth",
          "motion": "still",
          "text": "Stop me. I’m going to do it again.",
          "words_spoken": 8,
          "est_dur_s": 2.78,
          "src_script": "1.10#10 · 1.10#11"
        },
        {
          "clip_line_id": "TK1.01#2",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_dispatch_desk",
          "motion": "pull",
          "text": "At four in the morning on April twenty-fourth, 1973, the desk phone rang at Santa Cruz police headquarters.",
          "words_spoken": 18,
          "est_dur_s": 6.25,
          "src_script": "1.03#1 · 1.03#3"
        },
        {
          "clip_line_id": "TK1.01#3",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_phone_booth",
          "motion": "pan",
          "text": "On the line was Edmund Kemper, calling from a roadside payphone in Pueblo, Colorado, over a thousand miles away.",
          "words_spoken": 19,
          "est_dur_s": 6.6,
          "src_script": "1.03#2 · 1.03#3 · 1.03#5"
        },
        {
          "clip_line_id": "TK1.01#4",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_phone_booth",
          "motion": "push",
          "text": "His voice was calm and deliberate: <#0.35#> I killed my mother and her friend. And I killed those college girls. Six of them.",
          "words_spoken": 22,
          "est_dur_s": 7.64,
          "src_script": "1.05#4 · 1.05#5 · 1.05#6"
        },
        {
          "clip_line_id": "TK1.01#5",
          "role": "N1",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_dispatch_desk",
          "motion": "still",
          "text": "At first, dispatch assumed it was an intoxicated prank and told him to call back later.",
          "words_spoken": 16,
          "est_dur_s": 4.4,
          "src_script": "1.09#1 · 1.09#3"
        },
        {
          "clip_line_id": "TK1.01#6",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_phone_booth",
          "motion": "push",
          "text": "Two hours later he called again, with words that chilled the room: <#0.35#> Stop me. I’m going to do it again.",
          "words_spoken": 20,
          "est_dur_s": 6.95,
          "src_script": "1.09#4 · 1.10#10 · 1.10#11"
        },
        {
          "clip_line_id": "TK1.01#7",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_phone_booth",
          "motion": "still",
          "text": "He didn’t call to boast. He called because he was terrified that he couldn’t stop himself.",
          "words_spoken": 16,
          "est_dur_s": 5.56,
          "src_script": "1.10#12 · 1.10#13"
        },
        {
          "clip_line_id": "TK1.01#8",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.7,
          "bg": "t3_apartos_house",
          "motion": "pan",
          "text": "When patrol cars arrived, the six-foot-nine giant sat peacefully in the booth, with three rifles and hundreds of rounds in his car.",
          "words_spoken": 22,
          "est_dur_s": 8.85,
          "src_script": "1.03#6 · 1.07#4 · 1.09#5 · 1.09#6"
        },
        {
          "clip_line_id": "TK1.01#9",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_brain_mirror",
          "motion": "pull",
          "text": "With his ultimate target — his mother — dead, the omnipotent fantasy dissolved into profound emptiness, precipitating his psychological collapse.",
          "words_spoken": 20,
          "est_dur_s": 7.82,
          "src_script": "1.10#8 · 1.10#9 · 4.07#8 · 4.07#9"
        },
        {
          "clip_line_id": "TK1.01#10",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.0,
          "bg": "t3_closing_desk",
          "motion": "still",
          "text": "Episode three of Amber Eyes. Watch the full dossier via the link in our bio.",
          "words_spoken": 15,
          "est_dur_s": 5.21,
          "src_script": "CTA"
        }
      ]
    },
