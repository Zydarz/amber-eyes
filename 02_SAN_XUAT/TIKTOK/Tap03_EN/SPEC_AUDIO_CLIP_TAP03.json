      "lines": [
        {
          "clip_line_id": "TK4.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t3_vacaville_1978",
          "motion": "still",
          "text": "An IQ of one hundred and forty-five. The mind that changed the FBI forever.",
          "words_spoken": 14,
          "est_dur_s": 4.86,
          "src_script": "1.13#2 · 4.02#4 · 4.08#1"
        },
        {
          "clip_line_id": "TK4.01#2",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_two_agents",
          "motion": "pull",
          "text": "In nineteen seventy-eight, FBI Special Agents Robert Ressler and John Douglas entered the prison cell at Vacaville.",
          "words_spoken": 17,
          "est_dur_s": 6.84,
          "src_script": "4.02#1 · 4.02#4 · 4.02#8"
        },
        {
          "clip_line_id": "TK4.01#3",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_giant_doorway",
          "motion": "still",
          "text": "Kemper filled the doorway like a mountain, but he smiled politely and spoke with the measured cadence of a professor.",
          "words_spoken": 20,
          "est_dur_s": 8.04,
          "src_script": "4.05#1 · 4.05#2 · 4.05#3"
        },
        {
          "clip_line_id": "TK4.01#4",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_interview_room",
          "motion": "push",
          "text": "Possessing an IQ of 145, he demanded no plea deals or lawyers, dissecting his inner darkness with clinical precision.",
          "words_spoken": 19,
          "est_dur_s": 7.64,
          "src_script": "1.13#2 · 1.13#5 · 4.05#4 · 4.05#13 · 4.05#14"
        },
        {
          "clip_line_id": "TK4.01#5",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.7,
          "bg": "t3_cassette",
          "motion": "pan",
          "text": "Kemper explained a revolutionary concept to the FBI: The Violent Fantasy Cycle.",
          "words_spoken": 12,
          "est_dur_s": 4.83,
          "src_script": "4.07#1 · 4.07#2"
        },
        {
          "clip_line_id": "TK4.01#6",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.7,
          "bg": "t3_fantasy_spiral",
          "motion": "push",
          "text": "Homicide does not begin when weapons are drawn, but in hundreds of mental rehearsals conducted over years.",
          "words_spoken": 17,
          "est_dur_s": 6.84,
          "src_script": "4.07#3 · 4.07#4 · 4.07#5"
        },
        {
          "clip_line_id": "TK4.01#7",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_trophy_box",
          "motion": "still",
          "text": "He revealed why he took trophies: not to boast, but as catalysts to re-experience supreme power once post-crime euphoria faded.",
          "words_spoken": 20,
          "est_dur_s": 8.04,
          "src_script": "4.07#6 · 4.07#7"
        },
        {
          "clip_line_id": "TK4.01#8",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_organized_split",
          "motion": "pull",
          "text": "Dialogues with Kemper and thirty-five other felons formed the foundation for FBI organized offender classification and the ViCAP network.",
          "words_spoken": 19,
          "est_dur_s": 6.6,
          "src_script": "1.13#6 · 1.13#7 · 4.08#1 · 4.08#2 · 4.08#3"
        },
        {
          "clip_line_id": "TK4.01#9",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_self_observation",
          "motion": "still",
          "text": "Crime scenes leave more than physical clues: they leave the unique psychological signature of the perpetrator.",
          "words_spoken": 16,
          "est_dur_s": 6.26,
          "src_script": "4.08#4"
        },
        {
          "clip_line_id": "TK4.01#10",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_case_photos",
          "motion": "push",
          "text": "This dossier became the defining cornerstone for criminal behavioral analysis and the inspiration behind Mindhunter.",
          "words_spoken": 15,
          "est_dur_s": 5.21,
          "src_script": "4.08#6 · 4.08#7"
        },
        {
          "clip_line_id": "TK4.01#11",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.0,
          "bg": "t3_closing_desk",
          "motion": "still",
          "text": "Episode three of Amber Eyes. Watch the full dossier via the link in our bio.",
          "words_spoken": 15,
          "est_dur_s": 5.21,
          "src_script": "CTA"
        }
      ]
    },
    "TK5": {
      "id": "TK5",
      "title": "The Macdonald Triad and Four Early Red Flags",
      "theme": "Victimology & Four Critical Survival Warning Signs (Macdonald Triad)",
      "psychological_signs": [
