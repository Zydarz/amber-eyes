      ],
      "overlays": [
        {
          "after_id": "TK5.01#1",
          "text": "4 CRITICAL PSYCHOLOGICAL WARNING SIGNS",
          "dur_s": 3.0
        },
        {
          "after_id": "TK5.01#2",
          "text": "FLAG 1: CHILDHOOD MACDONALD TRIAD",
          "dur_s": 2.5
        },
        {
          "after_id": "TK5.01#4",
          "text": "FLAG 2: EXTREME DOMESTIC EMOTIONAL ABUSE",
          "dur_s": 2.5
        },
        {
          "after_id": "TK5.01#5",
          "text": "FLAG 3: IMMERSION IN DOMINATION FANTASY",
          "dur_s": 2.5
        },
        {
          "after_id": "TK5.01#6",
          "text": "FLAG 4: HIGH INTELLECT WITH SHALLOW AFFECT",
          "dur_s": 3.0
        },
        {
          "after_id": "TK5.01#8",
          "text": "HEALING CHILDHOOD WOUNDS AT HOME",
          "dur_s": 3.0
        }
      ],
      "lines": [
        {
          "clip_line_id": "TK5.01#1",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t3_red_flags",
          "motion": "still",
          "text": "Four early warning signs. So that no one becomes a victim.",
          "words_spoken": 11,
          "est_dur_s": 3.82,
          "src_script": "5.04#1 · 5.08#11"
        },
        {
          "clip_line_id": "TK5.01#2",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_gift_drowned",
          "motion": "push",
          "text": "Red flag one: The childhood Macdonald Triad. Intentional, premeditated animal cruelty beginning at age ten.",
          "words_spoken": 15,
          "est_dur_s": 5.87,
          "src_script": "5.05#1 · 5.05#2 · 5.05#4 · 5.05#6"
        },
        {
          "clip_line_id": "TK5.01#3",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_gift_drowned",
          "motion": "pull",
          "text": "It is a primary clinical indicator of severe empathy deficits and escalating violent conduct that families often overlook.",
          "words_spoken": 18,
          "est_dur_s": 7.04,
          "src_script": "5.05#6"
        },
        {
          "clip_line_id": "TK5.01#4",
          "role": "C",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t3_coal_furnace",
          "motion": "pan",
          "text": "Red flag two: Extreme domestic psychological abuse. Confining children in dark, isolated spaces and chronic verbal humiliation.",
          "words_spoken": 17,
          "est_dur_s": 6.65,
          "src_script": "5.05#7 · 5.05#8"
        },
        {
          "clip_line_id": "TK5.01#5",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.6,
          "bg": "t3_fantasy_spiral",
          "motion": "still",
          "text": "Red flag three: Immersion in violent domination fantasies severed from reality, coupled with obsessive research into weapons.",
          "words_spoken": 17,
          "est_dur_s": 6.84,
          "src_script": "5.06#1 · 5.06#2"
        },
        {
          "clip_line_id": "TK5.01#6",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.03,
          "pause_after_s": 0.7,
          "bg": "t3_self_observation",
          "motion": "push",
          "text": "And red flag four: Superior intellect paired with shallow affect, using intelligence to manipulate adults while void of genuine remorse.",
          "words_spoken": 20,
          "est_dur_s": 8.04,
          "src_script": "5.06#3 · 5.06#4"
        },
        {
          "clip_line_id": "TK5.01#7",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.7,
          "bg": "t3_life_sentence",
          "motion": "pull",
          "text": "Edmund Kemper was born with a genius intellect and imposing strength, but submerged in cruelty, those gifts mutated into destruction.",
          "words_spoken": 20,
          "est_dur_s": 6.95,
          "src_script": "5.08#8 · 5.08#9"
        },
        {
          "clip_line_id": "TK5.01#8",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.8,
          "bg": "t3_closing_desk",
          "motion": "still",
          "text": "Locking evil behind bars is the duty of the law. But identifying and healing emotional wounds in children is how we prevent evil.",
          "words_spoken": 23,
          "est_dur_s": 7.99,
          "src_script": "5.08#10 · 5.08#11"
        },
        {
          "clip_line_id": "TK5.01#9",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.0,
          "bg": "t3_closing_desk",
          "motion": "still",
          "text": "Episode three of Amber Eyes. Watch the full dossier via the link in our bio.",
          "words_spoken": 15,
          "est_dur_s": 5.21,
          "src_script": "CTA"
        }
      ]
    }
