      "overlays": [
        {
          "after_id": "TK1.01#1",
          "text": "PUEBLO, COLORADO · 4:00 AM · APRIL 24, 1973",
          "dur_s": 3.0
        },
        {
          "after_id": "TK1.01#4",
          "text": "“I KILLED MY MOTHER... AND SIX COLLEGE GIRLS”",
          "dur_s": 2.5
        },
        {
          "after_id": "TK1.01#6",
          "text": "“STOP ME. I'M GOING TO DO IT AGAIN”",
          "dur_s": 2.5
        },
        {
          "after_id": "TK1.01#8",
          "text": "3 RIFLES · HUNDREDS OF ROUNDS · SURRENDER",
          "dur_s": 2.5
        },
        {
          "after_id": "TK1.01#9",
