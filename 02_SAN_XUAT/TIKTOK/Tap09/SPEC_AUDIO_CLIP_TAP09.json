          "pause_after_s": 0.6,
          "bg": "t9_intact_valuables_diorama",
          "motion": "pull",
          "text": "Nỗi kinh hoàng nhất là chúng tôi nhận ra những kẻ đột nhập không hề hành động vì tiền tài hay trang sức quý giá.",
