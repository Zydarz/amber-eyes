          "pause_after_s": 0.7,
          "bg": "t9_manson_shadow_campfire_desert",
          "motion": "pull",
          "text": "狂信的な命令を冷徹に実行した結果だったのです。",
          "est_dur_s": 3.6,
          "src_script": "1.10#8",
          "characters_spoken": 23
        },
        {
