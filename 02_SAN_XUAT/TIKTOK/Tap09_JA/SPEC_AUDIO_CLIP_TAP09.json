          "src_script": "2.05#2",
          "characters_spoken": 77
        },
        {
          "clip_line_id": "TK2.01#5",
          "role": "H",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_apocalyptic_desert_hideout",
          "motion": "pull",
          "text": "そこで彼は、『Helter Skelter』と名付けた狂気じみた終末論を、彼らの心へと植え付け始めたのです。",
          "est_dur_s": 7.5,
          "src_script": "2.05#5",
          "characters_spoken": 53
        },
        {
          "clip_line_id": "TK2.01#6",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_midnight_convoy_old_ford",
          "motion": "still",
          "text": "第3段階: 夜間侵入ゲーム『Creepy Crawling』。",
          "est_dur_s": 4.6,
          "src_script": "2.06#6",
          "characters_spoken": 29
        },
        {
          "clip_line_id": "TK2.01#7",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_confiscated_clocks_broken_mirror",
          "motion": "push",
          "text": "Mansonは夜中に信者たちを率いて民家に忍び込ませ、物品を盗むのではなく家具の配置をずらすことで、全能感と不可視の支配力を実験させました。",
          "est_dur_s": 11.1,
          "src_script": "2.06#7",
          "characters_spoken": 70
        },
        {
          "clip_line_id": "TK2.01#8",
          "role": "D",
          "emotion": "neutral",
          "speed_offset": -0.02,
          "pause_after_s": 0.6,
          "bg": "t9_unfreezing_love_bombing_circle",
          "motion": "pan",
          "text": "罰せられることのない個人の領域への侵入を重ねるたびに、信者たちの脳内では悪事への許容閾値が一段ずつ引き上げられていったのです。",
          "est_dur_s": 10.0,
          "src_script": "2.06#8",
