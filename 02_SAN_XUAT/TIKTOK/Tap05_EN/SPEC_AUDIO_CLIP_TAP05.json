          "speed_offset": -0.02,
          "pause_after_s": 0.5,
          "bg": "t5_kerri_rawson_tears",
          "motion": "still",
          "text": "He taught me to ride a bike, walked me down the aisle. Then the FBI knocked.",
          "src_script": "hook — không phải dữ kiện kịch bản",
          "est_duration_s": 6.14
        },
        {
          "clip_line_id": "TK4.01#2",
          "role": "H",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.6,
          "bg": "t5_rader_house_park_city",
          "motion": "pan",
          "text": "Behind the offender's repulsive pride lay an agonizing catastrophe inflicted upon innocent family members.",
          "src_script": "4.14#1",
          "est_duration_s": 5.53
        },
        {
          "clip_line_id": "TK4.01#3",
          "role": "H",
          "emotion": "sad",
          "speed_offset": -0.04,
          "pause_after_s": 0.6,
          "bg": "t5_rader_house_park_city",
          "motion": "pull",
          "text": "His wife Paula suffered absolute devastation, while his children watched their cherished childhood memories dissolve into ashes.",
          "src_script": "4.14#2",
          "est_duration_s": 6.59
