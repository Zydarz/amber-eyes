          "dur_s": 3.0
        },
        {
          "after_id": "TK2.01#3",
          "text": "STAGE 1: THE SCARBOROUGH NIGHT PROWLER",
          "dur_s": 2.5
        },
        {
          "after_id": "TK2.01#5",
          "text": "STAGE 2: TOXIC SYMBIOTIC ALLIANCE",
          "dur_s": 2.5
        },
        {
          "after_id": "TK2.01#7",
