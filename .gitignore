# ============================================================
# AMBER EYES — .gitignore
# Quy tắc: KHÔNG commit media (âm thanh + video) và artifact dựng.
# Media/artifact được tái tạo: dựng lại từ kịch bản + .work/,
# hoặc tải lại từ nguồn (xem provenance.json).
# ============================================================

# ---------- Media: âm thanh ----------
*.mp3
*.wav
!assets/voice_ref_voxcpm2/*.wav
!assets/voice_ref_voxcpm2_g9/*.wav
!assets/voice_ref_voxcpm2_dc/*.wav
!assets/voice_ref_voxcpm2_dc2/*.wav
!assets/voice_ref_voxcpm2_dc3/*.wav
!assets/voice_ref_voxcpm2_en2/*.wav
!assets/voice_ref_voxcpm2_ja2/*.wav
!assets/voice_ref_voxcpm2_ko2/*.wav
!assets/voice_ref_voxcpm2_ja3/*.wav
!assets/voice_ref_voxcpm2_ko3/*.wav
!assets/voice_ref_voxcpm2_ko4/*.wav
!assets/voice_ref_voxcpm2_ko5/*.wav
!assets/pilot_voxcpm_clone/*.wav
*.ogg
*.m4a
*.flac
*.aac
*.wma
*.aiff
*.aif

# ---------- Media: video ----------
*.mp4
*.mov
*.webm
*.mkv
*.avi

# ---------- Kho ảnh nền (9,2 GB) — tái tạo: .work/gen_images.py ----------
assets/bg/

# ---------- Scratchpad .work: chỉ giữ script + config, bỏ artifact ----------
.work/*
!.work/*.py
!.work/*.json
!.work/*.md
!.work/*.txt
!.work/tap03_review/
# Ban sao tam khi sua file dung chung (vd edition_bak_muxaf_tmp.py) — file van con
# tren dia, chi bo the doi git. Ban chinh dung: .work/_cu/ theo L5.
.work/*_bak_*.py

# ---------- Artifact dựng, binary, cache ----------
*.tmp
*.bak
*.bak_*
*.zip
*.dll
*.exe
*.lib
*.a
*.h
*.pyc
__pycache__/

# ---------- Artifact QC (contact sheet / khung hien) — sinh lai duoc ----------
# 56 file PNG ~280 MB chi la QC output (build_video3.py --stills + script ghep sheet).
# KHONG commit: file van con tren dia, chi bo theo doi git.
# Tap sinh lai: .work/_make_stills_sheets_by_act_tXX.py, .work/_make_qc_tXX.py
02_SAN_XUAT/**/contact_sheet*.png
02_SAN_XUAT/**/contact_sheet*.jpg
02_SAN_XUAT/**/qc_*.png
02_SAN_XUAT/**/qc_*.jpg
# Thu muc QC trich frame thu cong (soi mo ta vs video): .work/_qc_frames/ + xuat_ban/_qc_frames/
02_SAN_XUAT/**/_qc_frames/
# Contact sheet ghep anh tinh theo hoi (Tap04 VN/EN/JA): 36 file PNG ~85,5 MB
# Chi la QC output — KHONG commit (L10). File van con tren dia.
02_SAN_XUAT/**/_qc_stills*/

# ---------- Thumbnail Tap01/Tap02 (tap da upload, media da xoa 02/11/2026) ----------
# package.py sinh lai thumbnail khi chay lai -> ignore de khong bi track lai
02_SAN_XUAT/Tap0[12]*/xuat_ban/thumbnail.png

# ---------- Ban copy trung thumbnail (Tap06_EN: Tap06_EN_thumb.png vs thumbnail.png) ----------
# Chi 1 thumbnail duoc commit, ten chuan la xuat_ban/thumbnail.png (package.py thumbnail()).
# Ban *_thumb.png trung byte voi no -> khong commit (file van con tren dia).
02_SAN_XUAT/**/xuat_ban/*_thumb.png

# ---------- Clip tham chieu VoxCPM2 moi cho G9 ----------
# Ban 48 kHz trung gian nam o .work/voxcpm_raw/ (da bi ignore boi `.work/*` o dong 31).
# Chi commit ban dong goi 24 kHz trong assets/voice_ref_voxcpm2_g9/
# LUU Y: phai co dong `!assets/voice_ref_voxcpm2_g9/*.wav` o tren — neu thieu,
# `git add assets/voice_ref_voxcpm2_g9` se KHONG them file .wav (vi `*.wav` bi ignore toan cuc).
